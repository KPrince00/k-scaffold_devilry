mixin inventoryCollapsedDetails()
    section(class=`inventory-collapsed-details collapsed-item`)
        +text({name:'name',class:'inventory-details span-6',placeholder:'Name'})
        +text({name:'basedmg',class:'inventory-details span-2',placeholder:'DMG'})
        +text({name:'attributes',class:'inventory-details span-6',placeholder:'Traits'})
        span(name='bp-label',class='domain-details')
            | TL
        +text({name:'techniquelvl',class:'inventory-details',placeholder:'TL'})

mixin inventoryExpandedDetails()
    section(class=`inventory-expanded-details expanded-item`)
        span(name='bp-label',class='domain-details')
            | Ca
        +text({name:'capacity',class:'inventory-details',placeholder:'pacity'})
        span(name='bp-label',class='domain-details')
            | Mi
        +text({name:'misfire',class:'inventory-details',placeholder:'sfire'})
        +text({name:'cost',class:'inventory-details span-4',placeholder:'Cost'})
        +adaptiveTextarea({name:'description',class:'underlined domain-details',placeholder:'Description'})


+scss.
    .inventory-collapsed-details,.inventory-expanded-details {
        display:grid;
        gap:0;
        grid-template-columns:repeat(8, 1.6em);
        box-sizing: border-box;
        span {
            padding-left: 5px;
            align-content: center;
            color: var(--accentFontColor)
        }

        textarea.inventory-details {
            font-size: small;
        }

        input.inventory-details {
            border: 1px solid var(--borderColor);
            width: 100%;
        }

        .adaptive {
            grid-column-start: span 8;
        }
        .span-7 {
            grid-column-start: span 6;
        }
        .span-6 {
            grid-column-start: span 6;
        }
        .span-5 {
            grid-column-start: span 6;
        }
        .span-4 {
            grid-column-start: span 4;
        }
        .span-2 {
            grid-column-start: span 2;
        }
    }