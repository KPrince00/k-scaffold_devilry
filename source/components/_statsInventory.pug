include ./_inventoryDetails.pug
section(class=`inventory`,aria-labelledby='inventory-details')#inventory.inventory-details.repeating-container
    section(class='repeating-controls-manual')
        h5 Inventory
        +customControlFieldset({name:'inventory'})
            +collapse
            +inventoryCollapsedDetails()
            .headed-textarea.description.expanded
                +inventoryExpandedDetails()

+scss.
    .inventory {
        grid-column-start: span 1;
        width: 100%;
        height: 12em; 

        .repeating-controls-manual {
            overflow-y: scroll;
            overflow-x: hidden;
            height: 100%;
            scrollbar-width: none;
            .repcontrol-button {
                top: -2.6px;
                position: absolute;
            }
        }

        .repeating-controls-manual::-webkit-scrollbar, .repeating-controls-manual::-webkit-scrollbar-button {
            display: none;
        }
    }

    .repcontrol{
        .repcontrol_edit {
            font-size: small;
        }
        .repcontrol_button {
            z-index: 3;
        }
    }

    .repcontainer {
        gap: var(--tiny-gap);

        .repitem {
            input.collapse {
                right: 0px;
                top: -2px;
                z-index: 3;
                color: var(--textColor);
            }
            .repcontrol_del {
                z-index: 3;
                position: relative;
            }
            .repcontrol_move {
                z-index: 3;
                position: relative;
            }
        }
    }